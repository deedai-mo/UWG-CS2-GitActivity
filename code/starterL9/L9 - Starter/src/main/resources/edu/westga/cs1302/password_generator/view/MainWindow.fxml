<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane minHeight="366.0" minWidth="215.0" prefHeight="429.0" prefWidth="430.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.password_generator.view.MainWindow">
   <children>
      <CheckBox fx:id="mustIncludeDigits" layoutX="109.0" layoutY="129.0" mnemonicParsing="false" text="Must Include Digits" />
      <CheckBox fx:id="mustIncludeLowerCaseLetters" layoutX="109.0" layoutY="146.0" mnemonicParsing="false" text="Must Include Lower Case Letters" />
      <CheckBox fx:id="mustIncludeUpperCaseLetters" layoutX="110.0" layoutY="166.0" mnemonicParsing="false" text="Must Include Upper Case Letters" />
      <Button fx:id="generatePasswordButton" layoutX="138.0" layoutY="190.0" mnemonicParsing="false" text="Generate Password" />
      <Label layoutX="93.0" layoutY="100.0" text="Minimum Length" />
      <TextField fx:id="minimumLength" layoutX="195.0" layoutY="96.0" prefHeight="25.0" prefWidth="41.0" />
      <Label fx:id="errorTextLabel" layoutX="6.0" layoutY="137.0" prefHeight="17.0" prefWidth="199.0" textFill="RED" />
      <ListView fx:id="passwordHistory" layoutX="97.0" layoutY="221.0" prefHeight="169.0" prefWidth="200.0" />
      <Label fx:id="minLengthErrorText" layoutX="40.0" layoutY="39.0" text="Must be a positive integer" textFill="RED" visible="false" />
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem fx:id="closeMenuItem" mnemonicParsing="false" onAction="#handleClose" text="Close" />
                  <MenuItem fx:id="aboutMenuItem" mnemonicParsing="false" onAction="#handleSave" text="Save" />
                  <MenuItem fx:id="aboutMenuItem" mnemonicParsing="false" onAction="#handleClose" text="About" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Edit">
            <items>
              <MenuItem mnemonicParsing="false" text="Delete" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </children>
</AnchorPane>
